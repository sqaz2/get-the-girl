rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function docOwnerUid() {
      if (resource != null && resource.data.uid != null) {
        return resource.data.uid;
      }
      return request.resource != null ? request.resource.data.uid : null;
    }

    function ownsDocument() {
      return isSignedIn() && docOwnerUid() == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && uid == request.auth.uid;
    }

    match /intake/{uid} {
      allow read, write: if ownsDocument() && uid == request.auth.uid;
    }

    match /drafts/{uid}/items/{draftId} {
      allow read, write: if ownsDocument() && uid == request.auth.uid;
    }

    match /reflections/{uid}/items/{reflectionId} {
      allow read, write: if ownsDocument() && uid == request.auth.uid;
    }

    match /prompts/{uid}/starters/{starterId} {
      allow read, write: if ownsDocument() && uid == request.auth.uid;
    }

    // Explicitly deny any collection that could store third-party personal data
    match /contacts/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
